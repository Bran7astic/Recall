.slots {
    background-color: rgba(0, 0, 0, 0);
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
    align-items: center;
    justify-content: center;
    align-self: center;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 19px;
    margin-right: 19px;
    margin-bottom: 19px;
    margin-left: 19px;
}
