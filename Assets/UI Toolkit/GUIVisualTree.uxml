    <ui:Button text="&#10;" parse-escape-sequences="true" display-tooltip-when-elided="true" name="Hotbar" style="height: 183px; justify-content: flex-start; align-self: center; align-items: center; background-color: rgba(0, 0, 0, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); position: absolute; bottom: 10px; width: 497px; border-top-left-radius: 19px; border-top-right-radius: 19px; border-bottom-right-radius: 19px; border-bottom-left-radius: 19px; opacity: 1;">
        <ui:VisualElement name="HotbarContainer" style="flex-grow: 1; flex-direction: row; align-items: stretch;">
            <ui:VisualElement name="Slot1" class="slots" style="flex-grow: 1; background-image: none; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); padding-top: -45px; padding-right: -45px; padding-bottom: -45px; padding-left: -45px; flex-direction: column; justify-content: center;">
                <ui:Button text="Button" parse-escape-sequences="true" display-tooltip-when-elided="true" name="GreenMemory" class="item hidden" style="background-image: url(&quot;project://database/Assets/GreenMemory-removebg-preview.png?fileID=2800000&amp;guid=bc30b46f7e2becc48b4dda46906b5857&amp;type=3#GreenMemory-removebg-preview&quot;);" />
