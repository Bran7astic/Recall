                <ui:Button text="Button" parse-escape-sequences="true" display-tooltip-when-elided="true" name="RedMemory" class="item hidden" style="background-image: url(&quot;project://database/Assets/RedMemory-removebg-preview.png?fileID=2800000&amp;guid=97e6b9f37b062a5409760dd9ace135d2&amp;type=3#RedMemory-removebg-preview&quot;);" />
            </ui:VisualElement>
